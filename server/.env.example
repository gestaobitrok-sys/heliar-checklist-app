# Copie este arquivo para ".env" na mesma pasta e preencha os valores.
# NUNCA suba o arquivo ".env" (com valores reais) para um repositório público.

# Porta interna do Node (o Caddy fica na frente, então isso não precisa ser 80/443)
PORT=3000

# Chave usada para assinar o token de login (JWT). Gere uma bem grande e aleatória, por exemplo com:
#   openssl rand -hex 48
# Se essa chave vazar ou mudar, todo mundo é deslogado.
JWT_SECRET=

# Deixe "true" (ou remova a linha) em produção — exige HTTPS para o cookie de login.
# Só use "false" se estiver testando localmente sem HTTPS.
COOKIE_SECURE=true

# Onde o banco de dados (SQLite) e as fotos ficam gravados no servidor
DATA_DIR=/opt/heliar/data
